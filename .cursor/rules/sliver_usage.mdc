## Sliver with Cubit Integration

### Sliver with State Management

```dart
class DataListScreen extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return BlocBuilder<DataCubit, DataState>(
      builder: (context, state) {
        return Scaffold(
          body: CustomScrollView(
            slivers: [
              SliverAppBar(
                title: Text(S.of(context).dataList),
                floating: true,
                snap: true,
              ),

              state.when(
                initial: () => SliverToBoxAdapter(child: SizedBox()),
                loading: () => LoadingSliver(),
                success: (dataList) => dataList.isEmpty
                    ? EmptyStateSliver(message: S.of(context).noDataAvailable)
                    : SliverList(
                        delegate: SliverChildBuilderDelegate(
                          (context, index) {
                            return DataListItem(
                              data: dataList[index],
                              onTap: () => context.read<DataCubit>().selectItem(dataList[index]),
                            );
                          },
                          childCount: dataList.length,
                        ),
                      ),
                error: (message) => SliverToBoxAdapter(
                  child: ErrorWidget(message: message),
                ),
              ),
            ],
          ),
        );
      },
    );
  }
}
```

## Performance Optimizations

### Sliver Performance Tips

1. **Use SliverChildBuilderDelegate**: Only build visible items
2. **Implement proper item keys**: Use unique keys for list items
3. **Limit item height**: Use fixed height when possible
4. **Avoid complex widgets**: Keep list items simple
5. **Use const constructors**: For static widgets

### Optimized Sliver List

```dart
SliverList(
  delegate: SliverChildBuilderDelegate(
    (context, index) {
      return Container(
        height: 80.0, // Fixed height for better performance
        child: DataListItem(
          key: ValueKey(dataList[index].id), // Unique key
          data: dataList[index],
          onTap: () => _handleItemTap(dataList[index]),
        ),
      );
    },
    childCount: dataList.length,
    findChildIndexCallback: (Key key) {
      final ValueKey valueKey = key as ValueKey;
      return dataList.indexWhere((data) => data.id == valueKey.value);
    },
  ),
)
```

## Common Sliver Patterns

### Sliver with Pull to Refresh

```dart
class RefreshableDataScreen extends StatefulWidget {
  @override
  _RefreshableDataScreenState createState() => _RefreshableDataScreenState();
}

class _RefreshableDataScreenState extends State<RefreshableDataScreen> {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: RefreshIndicator(
        onRefresh: () async {
          await context.read<DataCubit>().refreshData();
        },
        child: CustomScrollView(
          slivers: [
            SliverAppBar(
              title: Text(S.of(context).dataList),
              floating: true,
              snap: true,
            ),

            BlocBuilder<DataCubit, DataState>(
              builder: (context, state) {
                return state.when(
                  initial: () => SliverToBoxAdapter(child: SizedBox()),
                  loading: () => LoadingSliver(),
                  success: (dataList) => SliverList(
                    delegate: SliverChildBuilderDelegate(
                      (context, index) {
                        return DataListItem(
                          data: dataList[index],
                          onTap: () => _handleItemTap(dataList[index]),
                        );
                      },
                      childCount: dataList.length,
                    ),
                  ),
                  error: (message) => SliverToBoxAdapter(
                    child: ErrorWidget(message: message),
                  ),
                );
              },
            ),
          ],
        ),
      ),
    );
  }
}
```

