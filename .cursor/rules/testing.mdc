## Unit Testing

### Cubit Testing Pattern

```dart
import 'package:flutter_test/flutter_test.dart';
import 'package:mockito/mockito.dart';
import 'package:mockito/annotations.dart';

import 'package:invotek/features/auth/demo/cubit/auth_cubit.dart';
import 'package:invotek/features/auth/demo/repo/auth_repo.dart';

@GenerateMocks([AuthRepo])
import 'auth_cubit_test.mocks.dart';

void main() {
  group('AuthCubit Tests', () {
    late AuthCubit cubit;
    late MockAuthRepo mockRepo;

    setUp(() {
      mockRepo = MockAuthRepo();
      cubit = AuthCubit(mockRepo);
    });

    tearDown(() {
      cubit.close();
    });

    test('initial state should be AuthState.initial', () {
      expect(cubit.state, AuthState.initial());
    });

    test('login should emit loading then success state', () async {
      // Arrange
      final request = LoginRequest(email: 'test@example.com', password: 'password');
      final userModel = UserModel(user: User(name: 'Test User'), token: 'token');

      when(mockRepo.login(request)).thenAnswer(
        (_) async => ApiResult.success(userModel),
      );

      // Act
      await cubit.login(request, null);

      // Assert
      expect(cubit.state, AuthState.successLogin(userModel));
    });

    test('login should emit loading then error state on failure', () async {
      // Arrange
      final request = LoginRequest(email: 'test@example.com', password: 'password');
      final error = ErrorHandler.handle(Exception('Login failed'));

      when(mockRepo.login(request)).thenAnswer(
        (_) async => ApiResult.failure(error),
      );

      // Act
      await cubit.login(request, null);

      // Assert
      expect(cubit.state, isA<AuthState>());
      expect(cubit.state, AuthState.errorAuth(any));
    });
  });
}
```

### Repository Testing Pattern

```dart
import 'package:flutter_test/flutter_test.dart';
import 'package:mockito/mockito.dart';
import 'package:mockito/annotations.dart';

import 'package:invotek/features/auth/demo/repo/auth_repo.dart';
import 'package:invotek/features/auth/data/data_source/auth_data_source.dart';

@GenerateMocks([AuthDataSource])
import 'auth_repo_test.mocks.dart';

void main() {
  group('AuthRepo Tests', () {
    late AuthRepo repo;
    late MockAuthDataSource mockDataSource;

    setUp(() {
      mockDataSource = MockAuthDataSource();
      repo = AuthRepo(mockDataSource);
    });

    test('login should return success result', () async {
      // Arrange
      final request = LoginRequest(email: 'test@example.com', password: 'password');
      final userModel = UserModel(user: User(name: 'Test User'), token: 'token');

      when(mockDataSource.login(request)).thenAnswer(
        (_) async => ApiResult.success(userModel),
      );

      // Act
      final result = await repo.login(request);

      // Assert
      expect(result, isA<ApiResult<UserModel>>());
      result.when(
        success: (data) => expect(data, userModel),
        failure: (error) => fail('Should not fail'),
      );
    });

    test('login should return failure result on error', () async {
      // Arrange
      final request = LoginRequest(email: 'test@example.com', password: 'password');
      final error = ErrorHandler.handle(Exception('API Error'));

      when(mockDataSource.login(request)).thenAnswer(
        (_) async => ApiResult.failure(error),
      );

      // Act
      final result = await repo.login(request);

      // Assert
      expect(result, isA<ApiResult<UserModel>>());
      result.when(
        success: (data) => fail('Should not succeed'),
        failure: (error) => expect(error, isA<ErrorHandler>()),
      );
    });
  });
}
```

### Model Testing Pattern

```dart
import 'package:flutter_test/flutter_test.dart';
import 'package:invotek/features/auth/data/models/login_request.dart';

void main() {
  group('LoginRequest Tests', () {
    test('should create LoginRequest from JSON', () {
      // Arrange
      final json = {
        'email': 'test@example.com',
        'password': 'password123',
      };

      // Act
      final request = LoginRequest.fromJson(json);

      // Assert
      expect(request.email, 'test@example.com');
      expect(request.password, 'password123');
    });

    test('should convert LoginRequest to JSON', () {
      // Arrange
      final request = LoginRequest(
        email: 'test@example.com',
        password: 'password123',
      );

      // Act
      final json = request.toJson();

      // Assert
      expect(json['email'], 'test@example.com');
      expect(json['password'], 'password123');
    });

    test('should handle empty values', () {
      // Arrange
      final json = {
        'email': '',
        'password': '',
      };

      // Act
      final request = LoginRequest.fromJson(json);

      // Assert
      expect(request.email, '');
      expect(request.password, '');
    });
  });
}
```

## Widget Testing

### Widget Testing Pattern

```dart
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:flutter_bloc/flutter_bloc.dart';
import 'package:mockito/mockito.dart';

import 'package:invotek/features/auth/ui/auth_screen.dart';
import 'package:invotek/features/auth/demo/cubit/auth_cubit.dart';

class MockAuthCubit extends Mock implements AuthCubit {}

void main() {
  group('AuthScreen Tests', () {
    late MockAuthCubit mockCubit;

    setUp(() {
      mockCubit = MockAuthCubit();
    });

    testWidgets('should show login form initially', (WidgetTester tester) async {
      // Arrange
      when(mockCubit.state).thenReturn(AuthState.initial());

      // Act
      await tester.pumpWidget(
        MaterialApp(
          home: BlocProvider<AuthCubit>.value(
            value: mockCubit,
            child: AuthScreen(),
          ),
        ),
      );

      // Assert
      expect(find.text('تسجيل الدخول'), findsOneWidget);
      expect(find.byType(TextFormField), findsNWidgets(2));
    });

    testWidgets('should show loading indicator when loading', (WidgetTester tester) async {
      // Arrange
      when(mockCubit.state).thenReturn(AuthState.loadingAuth());

      // Act
      await tester.pumpWidget(
        MaterialApp(
          home: BlocProvider<AuthCubit>.value(
            value: mockCubit,
            child: AuthScreen(),
          ),
        ),
      );

      // Assert
      expect(find.byType(CircularProgressIndicator), findsOneWidget);
    });

    testWidgets('should show error message when error occurs', (WidgetTester tester) async {
      // Arrange
      when(mockCubit.state).thenReturn(AuthState.errorAuth('خطأ في تسجيل الدخول'));

      // Act
      await tester.pumpWidget(
        MaterialApp(
          home: BlocProvider<AuthCubit>.value(
            value: mockCubit,
            child: AuthScreen(),
          ),
        ),
      );

      // Assert
      expect(find.text('خطأ في تسجيل الدخول'), findsOneWidget);
    });

    testWidgets('should call login when form is submitted', (WidgetTester tester) async {
      // Arrange
      when(mockCubit.state).thenReturn(AuthState.initial());

      // Act
      await tester.pumpWidget(
        MaterialApp(
          home: BlocProvider<AuthCubit>.value(
            value: mockCubit,
            child: AuthScreen(),
          ),
        ),
      );

      await tester.enterText(find.byKey(Key('email_field')), 'test@example.com');
      await tester.enterText(find.byKey(Key('password_field')), 'password');
      await tester.tap(find.byType(ElevatedButton));
      await tester.pump();

      // Assert
      verify(mockCubit.login(any, any)).called(1);
    });
  });
}
```

### Custom Widget Testing Pattern

```dart
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
