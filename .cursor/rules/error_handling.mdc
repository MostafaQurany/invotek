## Error Handling in Cubits

### Cubit Error Handling Pattern
```dart
class AuthCubit extends Cubit<AuthState> {
  final AuthRepo repo;
  
  Future<void> login(LoginRequest request, BuildContext context) async {
    // Validation
    final emailError = Validators.validateEmail(request.email);
    final passwordError = Validators.validatePassword(request.password);

    if (emailError != null || passwordError != null) {
      emit(AuthState.errorAuth(S.of(context).validationError));
      return;
    }

    emit(AuthState.loadingAuth());

    try {
      final response = await repo.login(request);
      response.when(
        success: (data) {
          emit(AuthState.successLogin(data));
        },
        failure: (errorHandler) {
          final errorMessage = AppErrorHandler.getErrorMessage(
            ErrorType.authentication,
            errorHandler.apiErrorModel.message ?? 'فشل في تسجيل الدخول',
          );
          emit(AuthState.errorAuth(errorMessage));
        },
      );
    } catch (e, stackTrace) {
      final errorMessage = AppErrorHandler.getErrorMessage(
        ErrorType.unknown,
        e.toString(),
      );
      emit(AuthState.errorAuth(errorMessage));
    }
  }
}
```

## Error Handling in Repositories

### Repository Error Handling Pattern
```dart
class AuthRepo {
  final AuthDataSource dataSource;
  
  Future<ApiResult<UserModel>> login(LoginRequest request) async {
    try {
      AppLogger.logApiRequest('/login', request.toJson());
      final startTime = DateTime.now();

      final response = await dataSource.login(request);

      final duration = DateTime.now().difference(startTime);
      AppLogger.logPerformance('Login API Call', duration);

      response.when(
        success: (userModel) async {
          // Handle success
          StorageService.saveUserData(jsonEncode(userModel.toJson()));
          StorageService.saveToken(userModel.token ?? '');
          
          AppLogger.logApiResponse('/login', 200, userModel.toJson());
        },
        failure: (errorHandler) {
          AppLogger.logApiError('/login', errorHandler.apiErrorModel.message);
        },
      );

      return response;
    } catch (e, stackTrace) {
      AppLogger.error('Login repository error', error: e, stackTrace: stackTrace);
      return ApiResult.failure(
        ErrorHandler.handle(DataSource.defaultError.getFailure()),
      );
    }
  }
}
```

## Error Handling in UI

### UI Error Handling Pattern
```dart
class AuthScreen extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return BlocListener<AuthCubit, AuthState>(
      listener: (context, state) {
        state.whenOrNull(
          errorAuth: (message) {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Text(message),
                backgroundColor: Colors.red,
              ),
            );
          },
          successLogin: (userModel) {
            Navigator.pushReplacementNamed(context, '/home');
          },
        );
      },
      child: Scaffold(
        body: BlocBuilder<AuthCubit, AuthState>(
          builder: (context, state) {
            return state.when(
              initial: () => LoginForm(),
              loadingAuth: () => LoadingWidget(),
              successLogin: (userModel) => LoginForm(),
              successRegister: (userModel) => LoginForm(),
              errorAuth: (message) => LoginForm(),
            );
          },
        ),
      ),
    );
  }
}
```

## Validation Error Handling

### Form Validation Pattern
```dart
class Validators {
  static String? validateEmail(String? value) {
    if (value == null || value.isEmpty) {
      return S.current.emailRequired;
    }

    final emailRegex = RegExp(r'^[\w-\.]+@([\w-]+\.)+[\w-]{2,4}$');
    if (!emailRegex.hasMatch(value)) {
      return S.current.emailInvalid;
    }

    return null;
  }

  static String? validatePassword(String? value) {
    if (value == null || value.isEmpty) {
      return S.current.passwordRequired;
    }

    if (value.length < 6) {
      return S.current.passwordShort;
    }

    if (!RegExp(r'^(?=.*[a-z])(?=.*\d)').hasMatch(value)) {
      return S.current.passwordWeak;
    }

    return null;
  }
}
```

## Logging Errors

### Error Logging Pattern
```dart
class AppLogger {
  static void logApiError(String endpoint, String error) {
    print('API Error [$endpoint]: $error');
  }

  static void error(String message, {Object? error, StackTrace? stackTrace}) {
    print('Error: $message');
    if (error != null) print('Error details: $error');
    if (stackTrace != null) print('Stack trace: $stackTrace');
  }

  static void logApiRequest(String endpoint, Map<String, dynamic> data) {
    print('API Request [$endpoint]: $data');
  }

  static void logApiResponse(String endpoint, int statusCode, Map<String, dynamic> data) {
    print('API Response [$endpoint] ($statusCode): $data');
  }
}
```

## Error Recovery

### Error Recovery Strategies
1. **Retry Logic**: Implement retry for network errors
2. **Fallback Data**: Use cached data when network fails
3. **Graceful Degradation**: Show partial functionality
4. **User Guidance**: Provide helpful error messages
5. **Automatic Recovery**: Attempt to fix common issues

### Retry Implementation
```dart
Future<T> retryOperation<T>(
  Future<T> Function() operation, {
  int maxRetries = 3,
  Duration delay = const Duration(seconds: 1),
}) async {
  int attempts = 0;
  while (attempts < maxRetries) {
    try {
      return await operation();
    } catch (e) {
      attempts++;
      if (attempts >= maxRetries) rethrow;
      await Future.delayed(delay * attempts);
    }
  }
  throw Exception('Max retries exceeded');
}
```

