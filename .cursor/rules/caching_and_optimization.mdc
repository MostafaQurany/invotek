## Common Patterns

### Cache-Aware Repository

```dart
class CacheAwareRepository {
  final ApiService apiService;
  final CacheService cacheService;

  Future<Data> getData() async {
    // Try cache first
    final cachedData = await cacheService.getData();
    if (cachedData != null) return cachedData;

    // Fetch from API
    final apiData = await apiService.getData();
    await cacheService.saveData(apiData);
    return apiData;
  }
}
```

### Optimized Cubit

```dart
class OptimizedCubit extends Cubit<OptimizedState> {
  final Repository repository;

  Future<void> loadData() async {
    emit(OptimizedState.loading());

    try {
      final data = await repository.getData();
      emit(OptimizedState.success(data));
    } catch (error) {
      emit(OptimizedState.error(error.toString()));
    }
  }
}
```

