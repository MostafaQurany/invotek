```

### 4. دعم RTL

**للدعم الكامل للغة العربية:**
```dart
// استخدام Directionality
Directionality(
  textDirection: TextDirection.rtl,
  child: YourWidget(),
)

// أو استخدام Theme.of(context).textTheme
Text(
  text,
  style: Theme.of(context).textTheme.bodyLarge,
)
```

## أمثلة متقدمة

### 1. شاشة قائمة محسنة كاملة

```dart
class EnhancedListScreen extends StatefulWidget {
  const EnhancedListScreen({super.key});

  @override
  State<EnhancedListScreen> createState() => _EnhancedListScreenState();
}

class _EnhancedListScreenState extends State<EnhancedListScreen> {
  final _searchController = TextEditingController();
  String _selectedStatus = 'all';
  String _selectedCategory = 'all';

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: _buildAppBar(),
      body: Column(
        children: [
          // البحث
          CommonSearchBar(
            controller: _searchController,
            hintText: 'Search items...',
            onChanged: _onSearchChanged,
            onClear: _onSearchCleared,
          ),
          
          // الفلاتر
          CommonFilterRow(
            filters: [
              FilterConfig(
                label: 'Status',
                selectedValue: _selectedStatus,
                options: _buildStatusOptions(),
                onChanged: _onStatusChanged,
              ),
              FilterConfig(
                label: 'Category',
                selectedValue: _selectedCategory,
                options: _buildCategoryOptions(),
                onChanged: _onCategoryChanged,
              ),
            ],
          ),
          
          // القائمة
          Expanded(
            child: BlocBuilder<MyCubit, MyState>(
              builder: (context, state) {
                return state.when(
                  initial: () => _buildEmptyState(),
                  loading: () => _buildLoadingState(),
                  loaded: (items) => _buildItemsList(items),
                  error: (error) => _buildErrorState(error),
                );
              },
            ),
          ),
        ],
      ),
      floatingActionButton: CommonExtendedFAB(
        label: 'Add New Item',
        icon: Icons.add,
        onPressed: _addNewItem,
      ),
    );
  }

  Widget _buildItemsList(List<Item> items) {
    return RefreshIndicator(
      onRefresh: () async {
        context.read<MyCubit>().refresh();
      },
      child: ListView.builder(
        padding: EdgeInsets.only(bottom: 80.h),
        itemCount: items.length,
        itemBuilder: (context, index) {
          return AnimatedEntryWidget(
            delay: Duration(milliseconds: index * 50),
            child: ItemCard(
              item: items[index],
              onTap: () => _navigateToDetails(items[index]),
              onEdit: () => _editItem(items[index]),
              onDelete: () => _showDeleteConfirmation(items[index]),
            ),
          );
        },
      ),
    );
  }
}
```

### 2. Custom Dialog محسن

```dart
class CommonDeleteDialog extends StatelessWidget {
  const CommonDeleteDialog({
    super.key,
    required this.title,
    required this.message,
    required this.onConfirm,
  });

  final String title;
  final String message;
  final VoidCallback onConfirm;

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      backgroundColor: AppColors.surface,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(16.r),
      ),
      title: Text(
        title,
        style: TextStyle(
          color: AppColors.textPrimary,
          fontWeight: FontWeight.w600,
        ),
      ),
      content: Text(
        message,
        style: TextStyle(color: AppColors.textSecondary),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: Text(
            S.of(context).cancel,
            style: TextStyle(color: AppColors.textSecondary),
          ),
        ),
        FilledButton.tonal(
          onPressed: () {
            Navigator.pop(context);
            onConfirm();
          },
          style: FilledButton.styleFrom(
            backgroundColor: AppColors.error.withOpacity(0.1),
            foregroundColor: AppColors.error,
          ),
          child: Text(S.of(context).delete),
        ),
      ],
    );
  }
}
```

## قواعد الأداء

### 1. تحسين ListView

```dart
// استخدام ListView.builder للأداء
ListView.builder(
  itemCount: items.length,
  itemBuilder: (context, index) {
    return ItemCard(item: items[index]);
  },
)

// تجنب ListView مع children ثابتة
// ❌ ListView(children: items.map(...).toList())
```

### 2. تحسين البحث

```dart
// استخدام debounce للبحث
Timer? _searchTimer;

void _onSearchChanged(String query) {
  _searchTimer?.cancel();
  _searchTimer = Timer(Duration(milliseconds: 300), () {
    context.read<MyCubit>().search(query);
  });
}
```

### 3. تحسين الذاكرة

```dart
@override
void dispose() {
  _searchController.dispose();
  _searchTimer?.cancel();
  super.dispose();
}
```

